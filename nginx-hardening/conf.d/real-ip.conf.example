# /etc/nginx/conf.d/real-ip.conf
# Rename to .conf ONLY if Nginx is behind an AWS ALB/NLB, Cloudflare, or another proxy.
# Without this, rate limits and logs see the proxy's IP, not the client's.

# Trust only your LB/VPC range - never 0.0.0.0/0
set_real_ip_from 10.0.0.0/16;        # e.g. your VPC CIDR (ALB nodes)
# set_real_ip_from 173.245.48.0/20;  # Cloudflare ranges: https://www.cloudflare.com/ips/

real_ip_header    X-Forwarded-For;   # use CF-Connecting-IP for Cloudflare
real_ip_recursive on;
